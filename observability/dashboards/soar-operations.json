    {
      "type": "timeseries",
      "title": "Dead letter queue depth",
      "description": "Anything above zero means events or actions failed repeatedly and were parked rather than lost.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "aws_sqs_approximate_number_of_messages_visible_maximum{queue_name=~\".*dlq\"}",
          "legendFormat": "{{queue_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
