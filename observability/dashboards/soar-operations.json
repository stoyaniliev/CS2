          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (function_name) (aws_lambda_errors_sum{function_name=~\"innovatech-soar.*\"})",
          "legendFormat": "errors {{function_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
