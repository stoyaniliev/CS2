    {
      "type": "timeseries",
      "title": "Event flow through the pipeline",
      "description": "Per-minute counts. Dispatched and executed should track each other exactly; a gap between them means actions are failing.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(innovatech_soar_events_ingested_sum)",
          "legendFormat": "ingested",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum(innovatech_soar_playbook_matched_sum)",
          "legendFormat": "matched a playbook",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum(innovatech_soar_actions_dispatched_sum)",
          "legendFormat": "actions dispatched",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum(innovatech_soar_actions_executed_sum)",
          "legendFormat": "actions executed",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
