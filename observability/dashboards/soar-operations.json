      "targets": [
        {
          "expr": "sum by (action_type) (innovatech_soar_actions_failed_sum)",
          "legendFormat": "failed {{action_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (reason) (innovatech_soar_actions_skipped_sum)",
          "legendFormat": "refused: {{reason}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
