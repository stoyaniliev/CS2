    {
      "type": "timeseries",
      "title": "Failed and refused actions",
      "description": "Failures need investigation. Refusals are the safety guards working, and the reason label says which one.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
